# Copy to .env and replace every "change-me" (infrastructure/scripts/check-env.sh generates random values).
POSTGRES_USER=scan2world
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scan2world
JWT_SECRET=change-me-to-at-least-32-random-characters
SERVICE_TOKEN=change-me-internal-service-token

# Published ports
API_PORT=3000
WEB_PORT=8080
WEB_ORIGIN=http://localhost:8080

# Limits
MAX_IMAGES=200
MAX_FILE_MB=40
MIN_FREE_DISK_GB=5
RECON_THREADS=8
RECON_MEMORY_LIMIT=10g
GEOMETRY_MEMORY_LIMIT=6g
LOG_LEVEL=info
